PORT=4000
# Optional: comma-separated origins allowed to call the API straight from a browser.
# CORS_ORIGIN=https://dilrubatravels.com

# Database. `npm run dev` (from the repo root) starts a local Postgres-compatible database on
# port 5433 and stores it in backend/.data, so this works with no install.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Base URL used in email links (booking page, admin links).
PUBLIC_SITE_URL=http://localhost:3000

# Admin panel login (http://localhost:3000/admin). Create the hash with:
#   npm run admin:hash -w backend
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
# Optional locally (a random one is used, so you're logged out on restart).
SESSION_SECRET=

# Email (Resend). Leave empty locally: emails are printed in the backend terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Dilruba Travels <onboarding@resend.dev>
# EMAIL_REPLY_TO=Dilrubatravels1@gmail.com
# ADMIN_NOTIFY_EMAIL=you@example.com

# Razorpay test keys (Dashboard → switch to Test Mode → Account & Settings → API Keys).
# Leave empty to turn online payments off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
