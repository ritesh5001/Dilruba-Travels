# Production settings for the Express API.
# Copy to backend/.env on the server (the start script loads backend/.env),
# or set the same variables in your hosting provider's dashboard.

# Port the API listens on. Must match the port in the frontend's BACKEND_URL.
PORT=4000

# Leave unset unless another site must call the API directly from a browser:
# the Next.js frontend proxies /api/* server-side and doesn't need CORS.
# Comma-separated list of exact origins (scheme + host, no trailing slash), never "*".
CORS_ORIGIN=https://dilrubatravels.com,https://www.dilrubatravels.com

# PostgreSQL connection string, e.g. from Neon (neon.tech) or Render Postgres.
# Hosted databases need SSL: keep ?sslmode=require on the end.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_POOL_MAX=10

# The public website address, used in email links. No trailing slash.
PUBLIC_SITE_URL=https://dilrubatravels.com

# After a package is edited in /admin, the backend calls PUBLIC_SITE_URL/revalidate with this
# secret so the website shows the change on the next page load. Same value as the frontend's
# REVALIDATE_SECRET. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# The one admin login for /admin. Create the hash on any machine with:
#   npm run admin:hash -w backend
ADMIN_EMAIL=Dilrubatravels1@gmail.com
ADMIN_PASSWORD_HASH=scrypt:...
# Signs admin login cookies. At least 32 random characters, e.g. from: openssl rand -hex 32
# Changing it logs the admin out.
SESSION_SECRET=

# Resend (resend.com): add and verify the dilrubatravels.com domain first (DNS records),
# then create an API key with "Sending access".
RESEND_API_KEY=re_...
EMAIL_FROM=Dilruba Travels <bookings@dilrubatravels.com>
# Where customer replies go.
EMAIL_REPLY_TO=Dilrubatravels1@gmail.com
# Where new-lead, new-booking and payment alerts go (defaults to ADMIN_EMAIL).
ADMIN_NOTIFY_EMAIL=Dilrubatravels1@gmail.com

# Payment gateway. Only "razorpay" today; an ICICI option can be added later (backend/src/payments).
PAYMENT_PROVIDER=razorpay
# Razorpay live keys: Dashboard → Account & Settings → API Keys (needs completed KYC).
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → Add:
#   URL:    https://dilrubatravels.com/api/payments/webhook
#   Events: payment.captured, payment.failed
#   Secret: any long random string; put the same value here.
RAZORPAY_WEBHOOK_SECRET=
