{
  "name": "@dilruba/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "admin:hash": "node src/scripts/hash-password.ts",
    "db:local": "mkdir -p .data && pglite-server --db=.data/pglite --port=5433 --max-connections=10"
  },
  "dependencies": {
    "@dilruba/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "@types/pg": "8.23.0",
    "typescript": "^5"
  }
}
