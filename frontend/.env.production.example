# Production settings for the Next.js site.
# Copy to frontend/.env.production on the server (Next.js loads it for `next build` and `next start`),
# or set the same variables in your hosting provider's dashboard.

# Internal URL of the Express backend; the Next.js server proxies /api/* here.
# Use a private address (same machine or private network), not the public site URL.
# Read at BUILD time: rebuild the frontend after changing it.
BACKEND_URL=http://127.0.0.1:4000

# Package pages are built from the backend's catalogue (packages are edited in /admin), so the
# backend must be deployed and reachable when the site builds.

# Lets the backend tell the site to refresh package pages right after an admin edit
# (otherwise changes appear within a few minutes). Same value as REVALIDATE_SECRET on the backend.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Stop Next.js sending anonymous usage telemetry.
NEXT_TELEMETRY_DISABLED=1

# Note: the site's port can't be set here; Next.js starts its server before loading .env files.
# Set it in the shell or process manager instead, e.g. `PORT=3000 npm start -w frontend`.
